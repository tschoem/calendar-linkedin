{
  "manifest_version": 3,
  "name": "Calendar LinkedIn Lookup",
  "version": "1.4.1",
  "description": "Adds LinkedIn search icons next to Google Calendar contacts. Open in a side-panel embed and/or a new tab.",
  "author": "Thomas Schoemaecker",
  "homepage_url": "https://github.com/tschoem/calendar-linkedin",
  "permissions": ["storage", "sidePanel", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Calendar LinkedIn Lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
