{
  "manifest_version": 3,
  "name": "Calendar LinkedIn Lookup",
  "version": "1.6.2",
  "description": "Adds LinkedIn search icons next to contacts in Google Calendar and HubSpot. Open in a side window or a new tab.",
  "author": "Thomas Schoemaecker",
  "homepage_url": "https://github.com/tschoem/calendar-linkedin",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://*.hubspot.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Calendar LinkedIn Lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["settings.js", "shared.js", "content-calendar.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.hubspot.com/*"],
      "js": ["settings.js", "shared.js", "content-hubspot.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
